# Backend
# Debate provider: deterministic (default, no key needed) | gateway | swarm
DEBATE_PROVIDER=deterministic
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Phase 5 — Copilot / OpenAI-compatible gateway (only used when DEBATE_PROVIDER=gateway;
# on any gateway error/timeout the debate falls back to deterministic mid-beat)
# OPENAI_BASE_URL=https://api.githubcopilot.com
# OPENAI_API_KEY=
# GATEWAY_MODEL=gpt-4o-mini
# GATEWAY_TIMEOUT_S=20

# Optional seed for curveball / replay (Phase 6)
# GAME_SEED=42

# Pacing between streamed debate lines (ms); use 0 for headless tests
# DEBATE_DELAY_MS=600

# Boardroom vote plugin (Meridian beats 4 / 7 / 9). authored = scenario ballots; unknown names fall back.
# BOARD_VOTE_RESOLVER=authored

# v2 NovaTech plugins (unknown names fall back to deterministic)
# WAR_ROOM_PROVIDER=deterministic
# CARD_DEALER=deterministic
# RIVAL_POLICY=deterministic
# SCORING_MODEL=deterministic
# EVENT_DECK=deterministic
